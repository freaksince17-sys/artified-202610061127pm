rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Workshop training gallery photos & videos
    match /workshop_gallery/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    // Workshop masterclasses & groups created by seller
    match /workshop_groups/{groupId} {
      allow read: if true;
      allow write: if true;
    }

    // TikTok & Instagram showcase
    match /tiktok_reels/{reelId} {
      allow read: if true;
      allow write: if true;
    }

    match /instagram_journal/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    // Store settings (artisan profile, instagram settings, seller auth hash)
    match /store_settings/seller_auth {
      allow read: if true;
      allow create, update: if request.resource.data.passwordHash is string
                            && request.resource.data.passwordHash.size() == 64
                            && (!('customPassword' in request.resource.data) || request.resource.data.customPassword == null);
      allow delete: if false;
    }

    match /store_settings/{settingId} {
      allow read: if true;
      allow write: if settingId != 'seller_auth';
    }

    // Active profile
    match /activeProfile/seller_auth_backup {
      allow read: if true;
      allow create, update: if request.resource.data.passwordHash is string
                            && request.resource.data.passwordHash.size() == 64
                            && (!('customPassword' in request.resource.data) || request.resource.data.customPassword == null);
      allow delete: if false;
    }

    match /activeProfile/{profileId} {
      allow read: if true;
      allow write: if profileId != 'seller_auth_backup';
    }

    // User-keyed sub-collection for secure order tracking
    match /users/{userId}/tracked_orders/{orderId} {
      allow read, write: if true;
    }

    // Primary orders collection and nested status logs
    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if !('total' in request.resource.data) || (request.resource.data.total is number && request.resource.data.total >= 0);
      allow delete: if true;
      match /status_logs/{logId} {
        allow read, write: if true;
      }
    }

    // Direct tracked orders collection and nested status logs
    match /tracked_orders/{orderId} {
      allow read: if true;
      allow create, update: if !('total' in request.resource.data) || (request.resource.data.total is number && request.resource.data.total >= 0);
      allow delete: if true;
      match /status_logs/{logId} {
        allow read, write: if true;
      }
    }

    // Order status logs and email logs
    match /order_status_logs/{orderId} {
      allow read, write: if true;
    }

    match /order_emails/{emailId} {
      allow read, write: if true;
    }

    // Customer subscriptions and wishlists
    match /waitlist_subscribers/{subscriberId} {
      allow read, write: if true;
    }

    match /newsletter_subscribers/{subscriberId} {
      allow read, write: if true;
    }

    match /user_wishlists/{userId} {
      allow read, write: if true;
    }

    match /product_reviews/{reviewId} {
      allow read, write: if true;
    }

    // Sales history collection recording timestamp and productId whenever a sale is completed
    match /sales_history/{saleId} {
      allow read, write: if true;
    }

    match /salesHistory/{saleId} {
      allow read, write: if true;
    }

    // Daily website visitor analytics & traffic
    match /daily_visitors/{dateStr} {
      allow read, write: if true;
    }

    match /error_logs/{logId} {
      allow read, write: if true;
    }

    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
